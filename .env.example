# Copy to `.env` and edit for local development.
#
# After `pnpm run dev`, a local Langfuse instance runs at http://localhost:3000
# with the project below pre-seeded — these defaults work out of the box.

LANGFUSE_BASE_URL="http://localhost:3000"
LANGFUSE_PUBLIC_KEY="pk-lf-1234567890"
LANGFUSE_SECRET_KEY="sk-lf-1234567890"

# To run against Langfuse Cloud instead, comment out the section above and
# provide your own credentials:
# LANGFUSE_BASE_URL="https://cloud.langfuse.com"
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# Pin the Langfuse SDK version installed by the action (pip/npm).
# Default is "latest".
# LANGFUSE_SDK_VERSION=latest

# Optional: override the default e2e experiment name.
# EXPERIMENT_NAME=local-dev
